{
  "manifest_version": 3,
  "name": "Chrome Toolbox",
  "version": "0.1.0",
  "description": "Connect selected Chrome capabilities to your AI assistant through a local MCP server. You control access in the popup.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "readingList",
    "alarms",
    "storage"
  ],
  "optional_permissions": ["tabs", "tabGroups", "bookmarks", "history"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Toolbox",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
